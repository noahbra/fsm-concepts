# Optional. If set, the review hub shows a real "Submit feedback" button that POSTs JSON to this URL.
# Leave unset to keep the always-working Copy / Download feedback actions only.
# VITE_FEEDBACK_ENDPOINT=https://formspree.io/f/xxxxxxxx

# Set to "false" to hide reviewer chrome (ribbon, floating review pill) for a production build.
# VITE_REVIEW_MODE=true

# Base path for the build. The GitHub Pages workflow sets this to /<repo-name>/.
# BASE_PATH=/fsm-concepts/
